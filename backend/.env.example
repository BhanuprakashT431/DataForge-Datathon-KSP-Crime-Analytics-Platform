# Zoho Catalyst Configuration
CATALYST_PROJECT_ID=ksp-crime-intel-demo
CATALYST_ENVIRONMENT=Development

# Catalyst Service Toggles (set to 'true' to enable cloud integrations, otherwise runs in local fallback)
ENABLE_CATALYST_DATA_STORE=false
ENABLE_CATALYST_STRATUS=false
ENABLE_CATALYST_CACHE=false
ENABLE_CATALYST_ZCQL=false

# Gemini API Configuration
# Used strictly for Explanatory AI / Decision Support. Does not process raw queries.
GEMINI_API_KEY=your_gemini_api_key_here
